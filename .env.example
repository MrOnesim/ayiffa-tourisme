# Keep real credentials in .env; never commit secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Used for local builds and non-Vercel hosts. On Vercel, the platform's
# production hostname (or the connected custom domain) takes precedence.
NEXT_PUBLIC_SITE_URL=https://ayiffa-tourisme.vercel.app
# Enable only after the official production launch is approved.
SITE_INDEXABLE=false
